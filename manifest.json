{
  "manifest_version": 3,
  "name": "StreamFlow Pro - Smart Video & Speed Suite",
  "version": "2.1.0",
  "description": "Smart video controller with persistent playback speed memory, instant ad-skipping, continuous PiP, and Watch Later queue.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "StreamFlow Pro"
  }
}
