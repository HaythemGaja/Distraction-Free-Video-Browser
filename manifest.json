{
  "manifest_version": 3,
  "name": "StreamFlow Pro - Smart Video Suite",
  "version": "2.8.0",
  "description": "Universal video suite with persistent speed memory, A-B loop, instant ad-skipping, audio EQ, and Watch Later.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "StreamFlow Pro",
    "default_icon": "icon.svg"
  },
  "icons": {
    "128": "icon.svg"
  }
}
