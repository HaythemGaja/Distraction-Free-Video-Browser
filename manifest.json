{
  "manifest_version": 3,
  "name": "CinemaStream Pro - Video & Feed Suite",
  "version": "1.3.0",
  "description": "Distraction-free video suite with persistent speed memory, instant ad-skipping, FB Purity filters, panel controls, and Watch Later.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.youtube.com/*",
    "*://*.tiktok.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CinemaStream Pro"
  }
}
